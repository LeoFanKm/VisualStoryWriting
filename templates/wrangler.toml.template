# Cloudflare Workers 配置文件模板
# 复制这个文件到你的 backend 目录，命名为 wrangler.toml

name = "visualwriter-api"
main = "src/index.ts"
compatibility_date = "2024-01-01"
node_compat = true

# 开发环境配置
[env.development]
workers_dev = true

# 生产环境配置
[env.production]
workers_dev = false
routes = [
  { pattern = "api.yourdomain.com/*", zone_name = "yourdomain.com" }
]

# KV 命名空间（用于缓存和配额）
[[kv_namespaces]]
binding = "KV_CACHE"
id = "YOUR_KV_ID_HERE"
preview_id = "YOUR_PREVIEW_KV_ID_HERE"

# D1 数据库
[[d1_databases]]
binding = "DB"
database_name = "visualwriter-db"
database_id = "YOUR_DB_ID_HERE"

# R2 对象存储（用于文件上传）
[[r2_buckets]]
binding = "R2_BUCKET"
bucket_name = "visualwriter-assets"
preview_bucket_name = "visualwriter-assets-preview"

# 环境变量（非敏感信息）
[vars]
ENVIRONMENT = "production"
APP_NAME = "VisualWriter"
APP_VERSION = "1.0.0"

# 敏感信息通过 wrangler secret put 命令设置
# wrangler secret put CLERK_SECRET_KEY
# wrangler secret put OPENROUTER_API_KEY
# wrangler secret put STRIPE_SECRET_KEY
